rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. GLOBAL SAFETY NET (Default Deny Catch-All)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // HELPER FUNCTIONS & PREDICATES
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'itopaprop@gmail.com' ||
        request.auth.token.email == 'samanthasappy@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && resource != null && resource.data.email == request.auth.token.email)
      );
    }

    // =========================================================================
    // 2. USERS COLLECTION (/users/{userId})
    // Strict User Isolation: User A can only read and write their own data.
    // User A cannot read User B or User C data.
    // =========================================================================
    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        (resource.data.email != null && resource.data.email == request.auth.token.email) ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        (resource.data.id == request.auth.uid || resource.data.email == request.auth.token.email)
      );

      allow create: if isSignedIn() && (
        request.auth.uid == userId ||
        (request.resource.data.email != null && request.resource.data.email == request.auth.token.email) ||
        isAdmin()
      );

      allow update: if isSignedIn() && (
        isAdmin() || (
          (request.auth.uid == userId || resource.data.email == request.auth.token.email) &&
          // Prevent non-admin users from escalating their own role
          request.resource.data.role == resource.data.role
        )
      );

      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // =========================================================================
    // 3. MESSAGES COLLECTION (/messages/{messageId})
    // Direct User Isolation: Users can only read messages sent by or to them.
    // User A cannot snoop on messages between User B and User C.
    // =========================================================================
    match /messages/{messageId} {
      allow get: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        (resource.data.senderEmail != null && resource.data.senderEmail == request.auth.token.email) ||
        (resource.data.receiverEmail != null && resource.data.receiverEmail == request.auth.token.email) ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        (resource.data.senderEmail != null && resource.data.senderEmail == request.auth.token.email) ||
        (resource.data.receiverEmail != null && resource.data.receiverEmail == request.auth.token.email)
      );

      allow create: if isSignedIn() && (
        request.resource.data.senderId == request.auth.uid ||
        (request.resource.data.senderEmail != null && request.resource.data.senderEmail == request.auth.token.email) ||
        isAdmin()
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );

      allow delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.senderId == request.auth.uid
      );
    }

    // =========================================================================
    // 4. SHIFTS COLLECTION (/shifts/{shiftId})
    // Staff Duty Isolation: Staff User A can only see their own assigned shifts.
    // =========================================================================
    match /shifts/{shiftId} {
      allow get: if isSignedIn() && (
        resource.data.staffId == request.auth.uid ||
        (resource.data.staffEmail != null && resource.data.staffEmail == request.auth.token.email) ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.staffId == request.auth.uid ||
        (resource.data.staffEmail != null && resource.data.staffEmail == request.auth.token.email)
      );

      allow create, delete: if isAdmin();

      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.staffId == request.auth.uid
      );
    }

    // =========================================================================
    // 5. STAFF DIRECTORY (/staff/{staffId})
    // Staff Member Profile: User can only read and update their own staff record.
    // =========================================================================
    match /staff/{staffId} {
      allow get: if isSignedIn() && (
        staffId == request.auth.uid ||
        resource.data.id == request.auth.uid ||
        (resource.data.email != null && resource.data.email == request.auth.token.email) ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.id == request.auth.uid ||
        (resource.data.email != null && resource.data.email == request.auth.token.email)
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        staffId == request.auth.uid ||
        resource.data.id == request.auth.uid
      );

      allow create, delete: if isAdmin();
    }

    // =========================================================================
    // 6. RESIDENTS COLLECTION (/residents/{residentId})
    // Sensitive Medical & Care Plans: Restricted to Admins, Assigned Staff,
    // or the verified linked Family Relative.
    // =========================================================================
    match /residents/{residentId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        (resource.data.assignedStaffId != null && resource.data.assignedStaffId == request.auth.uid) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.residentLinkedId == residentId
        )
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        (resource.data.assignedStaffId != null && resource.data.assignedStaffId == request.auth.uid) ||
        (resource.data.relativeUserId != null && resource.data.relativeUserId == request.auth.uid)
      );

      allow create, delete: if isAdmin();

      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.assignedStaffId != null && resource.data.assignedStaffId == request.auth.uid)
      );
    }

    // =========================================================================
    // 7. CONSULTATIONS COLLECTION (/consultations/{consultationId})
    // Public Booking Submissions: User can only view their own consultation.
    // =========================================================================
    match /consultations/{consultationId} {
      allow create: if true;

      allow get: if isSignedIn() && (
        isAdmin() ||
        (resource.data.email != null && resource.data.email == request.auth.token.email)
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        (resource.data.email != null && resource.data.email == request.auth.token.email)
      );

      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 8. APPLICATIONS COLLECTION (/applications/{applicationId})
    // Intake & Job Applications: Confidential to applicant and Admins.
    // =========================================================================
    match /applications/{applicationId} {
      allow create: if true;

      allow get: if isSignedIn() && (
        isAdmin() ||
        (resource.data.email != null && resource.data.email == request.auth.token.email)
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        (resource.data.email != null && resource.data.email == request.auth.token.email)
      );

      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 9. ACTIVITY LOGS (/activity_logs/{logId})
    // Audit Trail: Viewable by Admin and the performing staff member.
    // =========================================================================
    match /activity_logs/{logId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        (resource.data.performer != null && resource.data.performer == request.auth.token.email)
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        (resource.data.performer != null && resource.data.performer == request.auth.token.email)
      );

      allow create: if isSignedIn();

      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 10. PUBLIC COMMUNITY EVENTS & GALLERY
    // Publicly readable, write access restricted strictly to Administrators.
    // =========================================================================
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 11. CONNECTION HEALTH CHECK
    // =========================================================================
    match /test/{docId} {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
