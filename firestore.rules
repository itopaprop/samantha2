rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'Admin' ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'samanthasappy@gmail.com' ||
          request.auth.token.email.lower() == 'itopaprop@gmail.com'
        ))
      );
    }

    // 1. Users collection: User A can ONLY read and update their own document.
    // User A cannot read or access User B or User C's profile.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Staff directory: Staff can get their own staff record, Admin can manage all
    match /staff/{staffId} {
      allow get: if isOwner(staffId) || isAdmin();
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 3. Residents: Admins and staff have access; Relatives can only access their linked resident
    match /residents/{residentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 4. Shifts: Staff can only read their assigned shifts; Admin manages all
    match /shifts/{shiftId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.staffId == request.auth.uid ||
          (resource.data.staffEmail != null && resource.data.staffEmail == request.auth.token.email)
        )
      );
      allow write: if isAdmin();
    }

    // 5. Messages: User can only read messages sent by them or sent to them
    match /messages/{messageId} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid ||
          (resource.data.receiverEmail != null && resource.data.receiverEmail == request.auth.token.email) ||
          (resource.data.senderEmail != null && resource.data.senderEmail == request.auth.token.email)
        )
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);
    }

    // 6. Activity logs: Authenticated read/create, Admin update/delete
    match /activity_logs/{logId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 7. Consultation bookings: Anyone can submit, only Admin can read/manage
    match /consultations/{consultationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 8. Applications: Anyone can submit, only Admin can read/manage
    match /applications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 9. Community events: Public read, Admin write
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Gallery: Public read, Admin write
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. Job vacancies: Public read, Admin write
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 12. SDK Connection health check
    match /test/{docId} {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
