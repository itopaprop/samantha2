rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Staff directory
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // 3. Residents
    match /residents/{residentId} {
      allow read, write: if true;
    }

    // 4. Shifts
    match /shifts/{shiftId} {
      allow read, write: if true;
    }

    // 5. Messages
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // 6. Activity logs
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // 7. Consultation bookings
    match /consultations/{consultationId} {
      allow read, write: if true;
    }

    // 8. Applications
    match /applications/{applicationId} {
      allow read, write: if true;
    }

    // 9. Community events
    match /events/{eventId} {
      allow read, write: if true;
    }

    // 10. Gallery
    match /gallery/{galleryId} {
      allow read, write: if true;
    }

    // 11. Job vacancies
    match /jobs/{jobId} {
      allow read, write: if true;
    }

    // 12. SDK Connection health check
    match /test/{docId} {
      allow read, write: if true;
    }

    // Fallback for any other documents/collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
