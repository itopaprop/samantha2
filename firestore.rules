rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public submissions for care portal
    match /applications/{appId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    match /consultation_bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Public read and authenticated write for events, gallery, jobs
    match /community_events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /residents/{residentId} {
      allow read, write: if true;
    }

    match /staff/{staffId} {
      allow read, write: if true;
    }

    match /shifts/{shiftId} {
      allow read, write: if true;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    match /care_logs/{logId} {
      allow read, write: if true;
    }

    // Catch-all safety
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
